# Copia este archivo como ".env" (sin ".example") en la raiz del proyecto y
# completa los valores reales. El archivo ".env" NUNCA debe subirse a un
# repositorio publico ni compartirse: contiene la contraseña de la base de datos.
#
# En XAMPP (desarrollo local) este archivo es opcional: si no existe, el
# proyecto usa automaticamente root sin contraseña sobre "revista_digital".

# --- Base de datos (Hostinger: hPanel > Bases de datos > MySQL) ---
DB_HOST=localhost
DB_NAME=u123456789_revista
DB_USER=u123456789_revista
DB_PASS=coloca_aqui_una_contrasena_fuerte
DB_CHARSET=utf8mb4

# --- Entorno ---
# "production" en el hosting real: oculta errores detallados y el enlace de
# recuperacion de contraseña en pantalla (solo se envia por correo).
# "local" (o vacio) en XAMPP.
APP_ENV=production
